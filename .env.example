# Create an API key at https://resend.com and add the same values in Vercel.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@vistrow.com
# This address must use a domain verified in your Resend account.
CONTACT_FROM_EMAIL=Vistrow Website <website@vistrow.com>

# Public Sanity connection used by the blog. These are not secret values.
NEXT_PUBLIC_SANITY_PROJECT_ID=uenz7w4c
NEXT_PUBLIC_SANITY_DATASET=production

# Write-access token for the daily blog automation to create Sanity drafts.
# Create at manage.sanity.io > API > Tokens (Editor permission is enough).
SANITY_API_TOKEN=

# Used by lib/blog-automation/generate.ts to draft daily blog posts.
OPENAI_API_KEY=

# Shared secret checked by app/api/cron/daily-blog/route.ts. Set the same
# value here and in Vercel; Vercel's cron caller sends it automatically as
# `Authorization: Bearer <value>`. Leaving it unset disables auth on that route.
CRON_SECRET=

# GA4 Measurement ID (G-XXXXXXXXXX) from analytics.google.com. Analytics are
# skipped entirely when this is unset - safe to leave blank in local dev.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
